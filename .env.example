# Runtime environment variables. Never commit a real .env file.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
APP_ENV=development
SESSION_TTL_MINUTES=30
LLM_TIMEOUT_SECONDS=30
MAX_CLARIFICATION_TURNS=8
CHAT_MEMORY_MAX_MESSAGES=8
CHAT_MEMORY_TTL_SECONDS=1800
RETENTION_SWEEP_SECONDS=60
