{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentriskguard.local/schemas/agent_chat.schema.json",
  "title": "M5.6 Agent Chat Contracts",
  "$defs": {
    "AgentChatRequest": {
      "additionalProperties": false,
      "description": "Unified conversational Agent request.",
      "properties": {
        "conversation_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conversation Id"
        },
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "message"
      ],
      "title": "AgentChatRequest",
      "type": "object"
    },
    "AgentChatResponse": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "needs_more_info",
            "ready_for_confirmation",
            "education_answer",
            "completed",
            "out_of_scope",
            "clarification_limit",
            "error"
          ],
          "title": "Status",
          "type": "string"
        },
        "reply": {
          "minLength": 1,
          "title": "Reply",
          "type": "string"
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "clarification_turns": {
          "default": 0,
          "maximum": 50,
          "minimum": 0,
          "title": "Clarification Turns",
          "type": "integer"
        },
        "max_clarification_turns": {
          "default": 8,
          "maximum": 50,
          "minimum": 1,
          "title": "Max Clarification Turns",
          "type": "integer"
        },
        "remaining_clarification_turns": {
          "default": 8,
          "maximum": 50,
          "minimum": 0,
          "title": "Remaining Clarification Turns",
          "type": "integer"
        },
        "preview": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preview"
        },
        "assessment": {
          "anyOf": [
            {
              "$ref": "#/$defs/AssessmentResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "explanation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Explanation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "education": {
          "anyOf": [
            {
              "$ref": "#/$defs/EducationAnswer"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "scenario": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioSimulationResult"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tool_activity": {
          "items": {
            "$ref": "#/$defs/ToolActivity"
          },
          "title": "Tool Activity",
          "type": "array"
        },
        "review_status": {
          "anyOf": [
            {
              "enum": [
                "pending",
                "approved"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Review Status"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/AgentError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "conversation_id",
        "status",
        "reply"
      ],
      "title": "AgentChatResponse",
      "type": "object"
    },
    "AgentError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "minLength": 1,
          "title": "Code",
          "type": "string"
        },
        "message": {
          "minLength": 1,
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "AgentError",
      "type": "object"
    },
    "AssessmentAssumptions": {
      "additionalProperties": false,
      "properties": {
        "currency": {
          "const": "CNY",
          "title": "Currency",
          "type": "string"
        },
        "income_constant": {
          "title": "Income Constant",
          "type": "boolean"
        },
        "forecast_months": {
          "maximum": 36,
          "minimum": 1,
          "title": "Forecast Months",
          "type": "integer"
        }
      },
      "required": [
        "currency",
        "income_constant",
        "forecast_months"
      ],
      "title": "AssessmentAssumptions",
      "type": "object"
    },
    "AssessmentMetrics": {
      "additionalProperties": false,
      "properties": {
        "income_total": {
          "minimum": 0,
          "title": "Income Total",
          "type": "number"
        },
        "monthly_payment_total": {
          "minimum": 0,
          "title": "Monthly Payment Total",
          "type": "number"
        },
        "debt_to_income_ratio": {
          "minimum": 0,
          "title": "Debt To Income Ratio",
          "type": "number"
        },
        "remaining_debt_total": {
          "minimum": 0,
          "title": "Remaining Debt Total",
          "type": "number"
        },
        "debt_count": {
          "minimum": 0,
          "title": "Debt Count",
          "type": "integer"
        },
        "monthly_surplus": {
          "title": "Monthly Surplus",
          "type": "number"
        },
        "surplus_ratio": {
          "title": "Surplus Ratio",
          "type": "number"
        }
      },
      "required": [
        "income_total",
        "monthly_payment_total",
        "debt_to_income_ratio",
        "remaining_debt_total",
        "debt_count",
        "monthly_surplus",
        "surplus_ratio"
      ],
      "title": "AssessmentMetrics",
      "type": "object"
    },
    "AssessmentResult": {
      "additionalProperties": false,
      "properties": {
        "assessment_id": {
          "minLength": 1,
          "title": "Assessment Id",
          "type": "string"
        },
        "request_id": {
          "minLength": 1,
          "title": "Request Id",
          "type": "string"
        },
        "model_version": {
          "minLength": 1,
          "title": "Model Version",
          "type": "string"
        },
        "parameter_version": {
          "minLength": 1,
          "title": "Parameter Version",
          "type": "string"
        },
        "metrics": {
          "$ref": "#/$defs/AssessmentMetrics"
        },
        "irr_results": {
          "items": {
            "$ref": "#/$defs/IrrResult"
          },
          "maxItems": 20,
          "title": "Irr Results",
          "type": "array"
        },
        "risk": {
          "$ref": "#/$defs/RiskAssessment"
        },
        "cashflow_series": {
          "items": {
            "$ref": "#/$defs/CashflowPoint"
          },
          "maxItems": 36,
          "minItems": 1,
          "title": "Cashflow Series",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "assumptions": {
          "$ref": "#/$defs/AssessmentAssumptions"
        }
      },
      "required": [
        "assessment_id",
        "request_id",
        "model_version",
        "parameter_version",
        "metrics",
        "irr_results",
        "risk",
        "cashflow_series",
        "warnings",
        "assumptions"
      ],
      "title": "AssessmentResult",
      "type": "object"
    },
    "CashflowPoint": {
      "additionalProperties": false,
      "properties": {
        "month_index": {
          "minimum": 1,
          "title": "Month Index",
          "type": "integer"
        },
        "income": {
          "minimum": 0,
          "title": "Income",
          "type": "number"
        },
        "debt_payment": {
          "minimum": 0,
          "title": "Debt Payment",
          "type": "number"
        },
        "surplus": {
          "title": "Surplus",
          "type": "number"
        },
        "cumulative_surplus": {
          "title": "Cumulative Surplus",
          "type": "number"
        }
      },
      "required": [
        "month_index",
        "income",
        "debt_payment",
        "surplus",
        "cumulative_surplus"
      ],
      "title": "CashflowPoint",
      "type": "object"
    },
    "ConversationState": {
      "additionalProperties": false,
      "properties": {
        "conversation_id": {
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Conversation Id",
          "type": "string"
        },
        "session_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Session Id"
        },
        "current_intent": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current Intent"
        },
        "last_topic": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Topic"
        },
        "last_assessment_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Assessment Id"
        },
        "last_tool": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Tool"
        },
        "last_answer_type": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Last Answer Type"
        },
        "clarification_turns": {
          "default": 0,
          "maximum": 50,
          "minimum": 0,
          "title": "Clarification Turns",
          "type": "integer"
        },
        "pending_question": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pending Question"
        },
        "created_at": {
          "format": "date-time",
          "title": "Created At",
          "type": "string"
        },
        "expires_at": {
          "format": "date-time",
          "title": "Expires At",
          "type": "string"
        }
      },
      "required": [
        "conversation_id",
        "created_at",
        "expires_at"
      ],
      "title": "ConversationState",
      "type": "object"
    },
    "EducationAnswer": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "topic_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Topic Ids",
          "type": "array"
        },
        "boundary_notice": {
          "const": "本结果仅供金融教育与个人负债压力自查参考，不构成信贷审批、授信、放款或投资建议。",
          "default": "本结果仅供金融教育与个人负债压力自查参考，不构成信贷审批、授信、放款或投资建议。",
          "title": "Boundary Notice",
          "type": "string"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "answer",
        "topic_ids"
      ],
      "title": "EducationAnswer",
      "type": "object"
    },
    "EducationCard": {
      "additionalProperties": false,
      "properties": {
        "topic_id": {
          "minLength": 1,
          "title": "Topic Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "key_points": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Key Points",
          "type": "array"
        },
        "allowed_actions": {
          "items": {
            "type": "string"
          },
          "title": "Allowed Actions",
          "type": "array"
        },
        "forbidden_claims": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Claims",
          "type": "array"
        },
        "keywords": {
          "items": {
            "type": "string"
          },
          "title": "Keywords",
          "type": "array"
        },
        "review_status": {
          "default": "pending",
          "enum": [
            "pending",
            "approved"
          ],
          "title": "Review Status",
          "type": "string"
        }
      },
      "required": [
        "topic_id",
        "title",
        "key_points"
      ],
      "title": "EducationCard",
      "type": "object"
    },
    "Explanation": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "maxLength": 240,
          "title": "Summary",
          "type": "string"
        },
        "risk_sources": {
          "items": {
            "$ref": "#/$defs/RiskSource"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Risk Sources",
          "type": "array"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "maxItems": 5,
          "minItems": 2,
          "title": "Actions",
          "type": "array"
        },
        "education": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Education",
          "type": "array"
        },
        "questions_to_consider": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Questions To Consider",
          "type": "array"
        },
        "boundary_notice": {
          "const": "本结果仅供金融教育与个人负债压力自查参考，不构成信贷审批、授信、放款或投资建议。",
          "title": "Boundary Notice",
          "type": "string"
        }
      },
      "required": [
        "summary",
        "risk_sources",
        "actions",
        "education",
        "questions_to_consider",
        "boundary_notice"
      ],
      "title": "Explanation",
      "type": "object"
    },
    "IrrResult": {
      "additionalProperties": false,
      "properties": {
        "debt_id": {
          "minLength": 1,
          "title": "Debt Id",
          "type": "string"
        },
        "monthly_irr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Irr"
        },
        "annualized_irr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Annualized Irr"
        },
        "status": {
          "enum": [
            "ok",
            "unavailable"
          ],
          "title": "Status",
          "type": "string"
        },
        "assumption": {
          "minLength": 1,
          "title": "Assumption",
          "type": "string"
        }
      },
      "required": [
        "debt_id",
        "status",
        "assumption"
      ],
      "title": "IrrResult",
      "type": "object"
    },
    "RiskAssessment": {
      "additionalProperties": false,
      "properties": {
        "score": {
          "maximum": 100,
          "minimum": 0,
          "title": "Score",
          "type": "integer"
        },
        "level": {
          "enum": [
            "低风险",
            "关注",
            "中风险",
            "高风险"
          ],
          "title": "Level",
          "type": "string"
        },
        "dimensions": {
          "items": {
            "$ref": "#/$defs/RiskDimension"
          },
          "maxItems": 4,
          "minItems": 4,
          "title": "Dimensions",
          "type": "array"
        },
        "top_contributors": {
          "items": {
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Top Contributors",
          "type": "array"
        }
      },
      "required": [
        "score",
        "level",
        "dimensions",
        "top_contributors"
      ],
      "title": "RiskAssessment",
      "type": "object"
    },
    "RiskDimension": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "debt_to_income",
            "debt_stack",
            "real_cost",
            "behavior_resilience"
          ],
          "title": "Id",
          "type": "string"
        },
        "raw_value": {
          "title": "Raw Value",
          "type": "number"
        },
        "score": {
          "minimum": 0,
          "title": "Score",
          "type": "number"
        },
        "max_score": {
          "exclusiveMinimum": 0,
          "title": "Max Score",
          "type": "number"
        },
        "weight": {
          "maximum": 1,
          "minimum": 0,
          "title": "Weight",
          "type": "number"
        },
        "contribution": {
          "minimum": 0,
          "title": "Contribution",
          "type": "number"
        }
      },
      "required": [
        "id",
        "raw_value",
        "score",
        "max_score",
        "weight",
        "contribution"
      ],
      "title": "RiskDimension",
      "type": "object"
    },
    "RiskSource": {
      "additionalProperties": false,
      "properties": {
        "dimension_id": {
          "minLength": 1,
          "title": "Dimension Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "detail": {
          "minLength": 1,
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "dimension_id",
        "title",
        "detail"
      ],
      "title": "RiskSource",
      "type": "object"
    },
    "ScenarioDraft": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "anyOf": [
            {
              "maxLength": 30,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "remaining_principal": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1000000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Principal"
        },
        "monthly_payment": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 100000,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Monthly Payment"
        },
        "remaining_periods": {
          "anyOf": [
            {
              "maximum": 120,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Remaining Periods"
        },
        "nominal_apr": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nominal Apr"
        }
      },
      "title": "ScenarioDraft",
      "type": "object"
    },
    "ScenarioExtractionResult": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "complete",
            "needs_more_info",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "scenario": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScenarioDraft"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "title": "Missing Fields",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "question": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Question"
        }
      },
      "required": [
        "status"
      ],
      "title": "ScenarioExtractionResult",
      "type": "object"
    },
    "ScenarioSimulationResult": {
      "additionalProperties": false,
      "properties": {
        "scenario_id": {
          "minLength": 1,
          "title": "Scenario Id",
          "type": "string"
        },
        "base_assessment": {
          "$ref": "#/$defs/AssessmentResult"
        },
        "scenario_assessment": {
          "$ref": "#/$defs/AssessmentResult"
        },
        "monthly_payment_delta": {
          "title": "Monthly Payment Delta",
          "type": "number"
        },
        "monthly_surplus_delta": {
          "title": "Monthly Surplus Delta",
          "type": "number"
        },
        "risk_score_delta": {
          "title": "Risk Score Delta",
          "type": "integer"
        },
        "risk_level_before": {
          "enum": [
            "低风险",
            "关注",
            "中风险",
            "高风险"
          ],
          "title": "Risk Level Before",
          "type": "string"
        },
        "risk_level_after": {
          "enum": [
            "低风险",
            "关注",
            "中风险",
            "高风险"
          ],
          "title": "Risk Level After",
          "type": "string"
        }
      },
      "required": [
        "scenario_id",
        "base_assessment",
        "scenario_assessment",
        "monthly_payment_delta",
        "monthly_surplus_delta",
        "risk_score_delta",
        "risk_level_before",
        "risk_level_after"
      ],
      "title": "ScenarioSimulationResult",
      "type": "object"
