{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studentriskguard.local/schemas/assessment_request.schema.json",
  "title": "AssessmentRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "session_id",
    "income",
    "debts"
  ],
  "properties": {
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "income": {
      "$ref": "#/$defs/income"
    },
    "debts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/debt"
      }
    },
    "forecast_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 36,
      "default": 12
    },
    "savings_balance": {
      "type": "number",
      "minimum": 0,
      "default": 0.0,
      "description": "用户当前手头存款总余额，单位元，用于现金流缓冲推演。"
    },
    "recurring_subscriptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/recurring_subscription"
      },
      "default": [],
      "description": "无借贷、无本金的持续性自动续费开销，不属于 debts 负债数组。"
    },
    "behavior": {
      "$ref": "#/$defs/behavior",
      "default": {},
      "description": "学生自报的行为与韧性信号，仅进入专家规则评分，不参与 DTI 或 IRR 计算。"
    }
  },
  "$defs": {
    "income": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monthly_disposable_allowance",
        "monthly_part_time_income"
      ],
      "properties": {
        "monthly_disposable_allowance": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        },
        "monthly_part_time_income": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000000
        }
      },
      "anyOf": [
        {
          "properties": {
            "monthly_disposable_allowance": {
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "properties": {
            "monthly_part_time_income": {
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "debt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "remaining_principal",
        "monthly_payment",
        "remaining_periods",
        "nominal_apr"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "remaining_principal": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        },
        "monthly_payment": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100000
        },
        "remaining_periods": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "nominal_apr": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "recurring_subscription": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "monthly_cost"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "description": "订阅名称，例如 B站连续包月会员。"
        },
        "monthly_cost": {
          "type": "number",
          "exclusiveMinimum": 0,
          "description": "每月扣费金额，单位元。"
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "borrow_to_repay": {
          "type": "boolean",
          "default": false,
          "description": "是否曾用新借款或分期偿还旧分期。"
        },
        "strict_overdue_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 0,
          "description": "过去12个月逾期次数；2次及以上触发严格逾期规则。"
        },
        "insufficient_months_last_3": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3,
          "default": 0,
          "description": "过去3个月中出现月底资金不足的月份数。"
        },
        "income_drop_30_cannot_cover": {
          "type": "boolean",
          "default": false,
          "description": "收入下降30%时是否无法覆盖支出与当前还款。"
        },
        "financial_cognition_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 1,
          "maximum": 5,
          "default": null,
          "description": "金融认知量表得分；小于等于3触发认知薄弱规则。"
        }
      }
    }
  }
}
